<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Improvers Workflow">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Consuming Repository -->
        <mxCell id="2" value="Consuming Repository"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1"
          vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Trigger -->
        <mxCell id="3" value="Schedule or&#xa;Manual Dispatch"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11"
          vertex="1" parent="1">
          <mxGeometry x="340" y="170" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow: Repository -> Trigger -->
        <mxCell id="4"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;"
          edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Caller Workflow -->
        <mxCell id="5" value="Caller Workflow"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1"
          vertex="1" parent="1">
          <mxGeometry x="340" y="310" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow: Trigger -> Caller -->
        <mxCell id="6"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;"
          edge="1" parent="1" source="3" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Input: Reusable workflow ref -->
        <mxCell id="7" value="Reusable workflow reference +&#xa;inherited secrets"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10"
          vertex="1" parent="1">
          <mxGeometry x="600" y="315" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow: Caller -> Input (dashed) -->
        <mxCell id="8"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"
          edge="1" parent="1" source="5" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Shared Improvers Workflow (container) -->
        <mxCell id="9" value="Shared Improvers Workflow"
          style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;dashed=1;spacingTop=10"
          vertex="1" parent="1">
          <mxGeometry x="140" y="450" width="710" height="420" as="geometry" />
        </mxCell>

        <!-- Task: Checkout -->
        <mxCell id="10" value="Checkout consuming&#xa;repository"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10"
          vertex="1" parent="1">
          <mxGeometry x="210" y="500" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Task: Graphify -->
        <mxCell id="11" value="Build Graphify&#xa;repository map"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10"
          vertex="1" parent="1">
          <mxGeometry x="410" y="500" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow: Checkout -> Graphify -->
        <mxCell id="23"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"
          edge="1" parent="1" source="10" target="11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Task: Janitor -->
        <mxCell id="12" value="Run janitor task"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10"
          vertex="1" parent="1">
          <mxGeometry x="170" y="650" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Task: Suppression -->
        <mxCell id="13" value="Run suppression-&#xa;review task"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10"
          vertex="1" parent="1">
          <mxGeometry x="330" y="650" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Task: QA -->
        <mxCell id="14" value="Run QA coverage&#xa;task"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10"
          vertex="1" parent="1">
          <mxGeometry x="490" y="650" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Task: Publish -->
        <mxCell id="15" value="Publish usage&#xa;metrics"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10"
          vertex="1" parent="1">
          <mxGeometry x="650" y="650" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Arrows: Graphify fans out to the four tasks -->
        <mxCell id="24"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="25"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          edge="1" parent="1" source="11" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="26"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          edge="1" parent="1" source="11" target="14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="27"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          edge="1" parent="1" source="11" target="15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Output: Branch + PR per task -->
        <mxCell id="16" value="Branch +&#xa;Pull Request"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9"
          vertex="1" parent="1">
          <mxGeometry x="170" y="800" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="17" value="Branch +&#xa;Pull Request"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9"
          vertex="1" parent="1">
          <mxGeometry x="330" y="800" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="18" value="Branch +&#xa;Pull Request"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9"
          vertex="1" parent="1">
          <mxGeometry x="490" y="800" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Arrows from tasks to outputs -->
        <mxCell id="19"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          edge="1" parent="1" source="12" target="16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="20"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          edge="1" parent="1" source="13" target="17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="21"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          edge="1" parent="1" source="14" target="18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Caller -> Checkout (into the container) -->
        <mxCell id="22"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          edge="1" parent="1" source="5" target="10">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="420" />
              <mxPoint x="280" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
